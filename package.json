{
  "name": "resaf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Financially backed reservation infrastructure for agentic commerce.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "paypal:smoke": "node --env-file=.env.local scripts/paypal-smoke.mjs",
    "db:setup": "node --env-file=.env.local scripts/db-setup.mjs",
    "start": "node server.mjs",
    "build": "esbuild ui/main.jsx --bundle --format=esm --minify --outfile=public/assets/app.js --define:process.env.NODE_ENV='\"production\"'"
  },
  "dependencies": {
