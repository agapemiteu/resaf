{
  "name": "resaf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PayPal-backed AI reservations for businesses.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "paypal:smoke": "node --env-file=.env.local scripts/paypal-smoke.mjs",
    "db:setup": "node --env-file=.env.local scripts/db-setup.mjs",
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "build": "esbuild ui/main.jsx --bundle --format=esm --minify --outfile=public/assets/app.js --define:process.env.NODE_ENV='\"production\"'",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "0.28.2",
    "pg": "^8.23.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "license": "MIT"
}
