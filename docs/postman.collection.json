{
  "info": {
    "name": "Resaf policy discovery and access checks",
    "description": "Safe checks: reads current policy and verifies unauthenticated writes fail. Does not create payments or modify policies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "base_url", "value": "https://resaf-api.onrender.com" }],
  "item": [
    {
      "name": "Discover resource",
      "request": { "method": "GET", "url": "{{base_url}}/api/v1/resources/bag-001" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Resource is available through API', () => pm.response.to.have.status(200));",
        "pm.test('Resource has inventory state', () => pm.expect(pm.response.json().status).to.be.a('string'));"
      ] } }]
    },
    {
      "name": "Discover effective policy",
      "request": { "method": "GET", "url": "{{base_url}}/api/v1/resources/bag-001/policy" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Policy discovery is free', () => pm.response.to.have.status(200));",
        "pm.test('Terms include commitment and refund rules', () => { const p = pm.response.json(); pm.expect(p.commitment_amount).to.match(/^\\d+\\.\\d{2}$/); pm.expect(p.release_refund_bps).to.be.within(0, 10000); });"
      ] } }]
    },
    {
      "name": "Reject unauthenticated policy write",
      "request": { "method": "POST", "url": "{{base_url}}/api/v1/resources/bag-001/policy" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Merchant credentials are required', () => pm.response.to.have.status(401));"
      ] } }]
    }
  ]
}
