PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret
PAYPAL_RETURN_URL=https://example.com/resaf/paypal-return
PAYPAL_CANCEL_URL=https://example.com/resaf/paypal-cancel
DATABASE_URL=postgresql://replace-with-a-server-side-postgres-connection-string
DEMO_AGENT_A_KEY=replace-with-a-long-random-key
DEMO_AGENT_B_KEY=replace-with-a-different-long-random-key
CALLBACK_SIGNING_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-different-long-random-secret
MERCHANT_API_KEY=replace-with-a-server-side-merchant-key
GEMINI_API_KEY=replace-with-a-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
PAYPAL_WEBHOOK_ID=replace-with-registered-sandbox-webhook-id

# Optional fallback when Gemini is rate-limited. Server-only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
